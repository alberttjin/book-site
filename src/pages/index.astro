---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { book } from "../config";
import { withBase } from "../utils/paths";

const chapters = (await getCollection("chapters"))
  .filter((entry) => entry.data.published)
  .sort((a, b) => b.data.chapter - a.data.chapter);
---

<Layout description={book.description}>
  <p class="intro">{book.description}</p>

  {chapters.length === 0 ? (
    <p>No chapters published yet.</p>
  ) : (
    <ul class="chapter-list">
      {chapters.map((chapter) => (
        <li>
          <a href={withBase(`chapters/${chapter.slug}/`)}>
            <span class="chapter-number">Chapter {chapter.data.chapter}</span>
            <span class="chapter-title">{chapter.data.title}</span>
            {chapter.data.summary && (
              <p class="chapter-summary">{chapter.data.summary}</p>
            )}
          </a>
        </li>
      ))}
    </ul>
  )}
</Layout>
