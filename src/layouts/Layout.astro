---
import "../styles/global.css";
import ChapterSidebar from "../components/ChapterSidebar.astro";
import { book } from "../config";
import { withBase } from "../utils/paths";

interface Props {
  title?: string;
  description?: string;
  currentSlug?: string;
}

const { title, description = book.description, currentSlug } = Astro.props;
const pageTitle = title ? `${title} · ${book.title}` : book.title;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <h1><a href={withBase("")}>{book.title}</a></h1>
      <p>by {book.author}</p>
    </header>
    <div class="page-shell">
      <ChapterSidebar currentSlug={currentSlug} />
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
